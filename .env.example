APP_NAME="Framework Application"
APP_ENV=local # local | production | testing
APP_KEY=
APP_DEBUG=true # true | false
APP_URL=http://localhost:8000
APP_DOMAIN=localhost
APP_FORCE_JSON=false # true | false

# Logging
LOG_LEVEL=info # debug | info | warning | error | critical

# Database
DB_CONNECTION=mysql # mysql | pgsql | sqlite | sqlsrv | mongodb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=framework
DB_USERNAME=root
DB_PASSWORD=

# Cache
CACHE_DRIVER=file # file | redis | memcached | array
CACHE_PREFIX=framework_cache:

# Queue
QUEUE_DRIVER=database # sync | database | redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Storage
FILESYSTEM_DISK=local # local | s3 | r2 | ftp

# Security / WAF
WAF_DRIVER=file # file | db | redis
WAF_BLOCK_DURATION=3600

# WebSockets
WS_HOST=0.0.0.0
WS_PORT=8080
WS_INTERNAL_PORT=8081

# Mail
MAIL_DRIVER=smtp # smtp | log | mailgun | ses | postmark
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls # tls | ssl | null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}" # You can reference other variables using ${VAR}

# Mailgun API
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Postmark API
POSTMARK_TOKEN=

# Amazon SES uses the AWS_* credentials located below.

# AWS S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# FTP Storage
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_PORT=21
FTP_ROOT=/

# JWT Authentication
JWT_SECRET=
