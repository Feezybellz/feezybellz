# Generated by `php console make:env`
# Source: config/*.php (statically scanned) + .env.example (fallback)
# Regenerate anytime — this file's format is intentionally boring.

# --------------------------------------------------------------------
# app.php
# --------------------------------------------------------------------
APP_NAME="Framework Application"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_KEY=""
APP_DOMAIN=""
APP_FORCE_JSON=false
JWT_SECRET=""
GOOGLE_MAP_API_KEY=""
WS_URL=""
WS_PORT=8080
WS_INTERNAL_PORT=8081
WS_HOST=0.0.0.0
MINIMUM_WALLET_FUNDING=500
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_USE_ACL=false
AWS_ACL=public-read

# --------------------------------------------------------------------
# cache.php
# --------------------------------------------------------------------
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CACHE_DB=1
CACHE_PREFIX=framework_cache:
MEMCACHED_PERSISTENT_ID=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# --------------------------------------------------------------------
# closure_serializer.php
# --------------------------------------------------------------------
CLOSURE_SERIALIZER_ENABLED=false

# --------------------------------------------------------------------
